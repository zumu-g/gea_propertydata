# Property Data Website - Environment Variables
# Copy this file to .env.local and fill in your values

# Property.com.au API
PROPERTY_API_BASE_URL=https://api.property.com.au/v1
PROPERTY_API_KEY=your_property_api_key_here

# Planning.vic.gov.au API
PLANNING_VIC_API_BASE_URL=https://api.planning.vic.gov.au/v1
PLANNING_API_KEY=your_planning_api_key_here

# Optional: Analytics
NEXT_PUBLIC_GA_ID=

# Optional: Error tracking
SENTRY_DSN=
